# Copy this file to .env and fill in your values
# cp .env.example .env

# ── PostgreSQL ──────────────────────────────────────────────────────────────
POSTGRES_USER=platform
POSTGRES_PASSWORD=changeme
POSTGRES_DB=image_platform
# Used by Go services (docker-compose internal hostname: postgres)
DATABASE_URL=postgres://platform:changeme@postgres:5432/image_platform?sslmode=disable
# For local dev against exposed port:
# DATABASE_URL=postgres://platform:changeme@localhost:5432/image_platform?sslmode=disable

# ── Object storage: S3-compatible (Scality CloudServer) ──────────────────────
# MinIO gated its registry images behind `docker login` in 2025, so the stack
# now uses zenko/cloudserver (freely pullable) speaking the same S3 API.
# These are CloudServer's built-in default credentials. The MINIO_* names are
# kept because the Go client (minio-go) and its config still use them.
# Used by Go services (docker-compose internal hostname: minio)
MINIO_ENDPOINT=minio:8000
MINIO_ACCESS_KEY=accessKey1
MINIO_SECRET_KEY=verySecretKey1
MINIO_USE_SSL=false
# For local dev against exposed port:
# MINIO_ENDPOINT=localhost:8000

# ── RabbitMQ ─────────────────────────────────────────────────────────────── (chapter 2)
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/

# ── API Service ─────────────────────────────────────────────────────────────
API_PORT=8080
MAX_UPLOAD_SIZE_MB=10
MAX_MEGAPIXELS=50000000
PRESIGNED_URL_TTL_MINUTES=60

# ── Job Service ──────────────────────────────────────────────────────────── (chapter 2)
JOB_SERVICE_PORT=8081
OUTBOX_POLL_MS=500
