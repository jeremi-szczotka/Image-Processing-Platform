# Copy this file to .env and fill in your values
# cp .env.example .env

# ── PostgreSQL ──────────────────────────────────────────────────────────────
POSTGRES_USER=platform
POSTGRES_PASSWORD=changeme
POSTGRES_DB=image_platform
# Used by Go services (docker-compose internal hostname: postgres)
DATABASE_URL=postgres://platform:changeme@postgres:5432/image_platform?sslmode=disable
# For local dev against exposed port:
# DATABASE_URL=postgres://platform:changeme@localhost:5432/image_platform?sslmode=disable

# ── MinIO ───────────────────────────────────────────────────────────────────
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
# Used by Go services (docker-compose internal hostname: minio)
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_USE_SSL=false
# For local dev against exposed port:
# MINIO_ENDPOINT=localhost:9000

# ── RabbitMQ ─────────────────────────────────────────────────────────────── (chapter 2)
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/

# ── API Service ─────────────────────────────────────────────────────────────
API_PORT=8080
MAX_UPLOAD_SIZE_MB=10
MAX_MEGAPIXELS=50000000
PRESIGNED_URL_TTL_MINUTES=60

# ── Job Service ──────────────────────────────────────────────────────────── (chapter 2)
JOB_SERVICE_PORT=8081
